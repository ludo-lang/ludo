-- The ludo reference program.
--
-- Grown one chapter at a time (ADR-0044 §7). Chapter 1 seeds it with the
-- lexical and grammatical surface and nothing else: every construct below is
-- spelled by docs/spec/01-grammar.md and parses against docs/spec/grammar.ebnf.
-- Chapter 2 adds the constructs whose *meaning* it fixes — absence, failure,
-- the bug line, generics, function types, and text. Chapter 3 adds memory —
-- layout, the two aggregates and their literal, views and the rules that keep
-- them from dangling, moves, and multiple returns.
--
-- The dynamic container set is now fixed at `List` + `Map` (ch3 §11.3), so this
-- program exercises it: a fallible `push`, a `reserve` before a batch, and a
-- `persist` container. What it still does not name is a pool.
--
-- Container *removal* is no longer a gap: ch3 §11.13-§11.13.9 specify it, and
-- ADR-0050 adds the descending range operator `>..` that its cull needs. This
-- program does not exercise any of it yet -- the extension is split out to
-- #109 under ADR-0049 §4, which lets a large reference-program extension
-- become its own work while the clause repair never splits. Until #109 lands,
-- `trail` below grows unbounded and is the leak that ticket also fixes.
--
-- Until a frontend exists this file is checked by hand. It is written fresh:
-- prototypes/07-syntax/b-lua-flavoured.ludo is not a starting point, and breaks
-- six ways against the current corpus (ADR-0044 §7).

-- Chapter 4 makes this file the **entry file of a program with three modules**,
-- which is the whole of what it adds. `libs/vec-utils/` is a library because it
-- claims a name; `hud.ludo` is this program's own file and is reached by path;
-- the boundary between the two forms is the chapter's subject (ch4 §3.1).
--
-- A library is named, never located: nothing below says where `vec-utils` is,
-- and moving it -- to a cache, to a vendor directory -- changes no line here
-- (ch4 §3.3). The runner finds it by scanning `libs/` because no build tool
-- supplied a mapping (ch4 §8.1).
use "vec-utils"

-- A path reference names one file, extension written, relative to this file's
-- directory, and binds the file's stem (ch4 §3.4). This spelling is authored by
-- chapter 4 §15.1: ADR-0014 §7 fixed the rule and never wrote the form.
use "./hud.ludo"

const MAX_ROCKS = 64

type Vec2 = struct
  x: f32 = 0.0
  y: f32 = 0.0
end

type Rock = struct
  pos:    Vec2
  vel:    Vec2
  radius: f32 = 4.0
end

type Shape = enum
  point
  circle(f32)
  box(Vec2, Vec2)
end

type RockId = distinct u32

type Seconds = distinct numeric f32

-- One error set, declared in this file, so `rescue` with no set named elides to
-- it (spec ch2 §10.6).
type FieldError = enum
  empty
  too_many(usize)
end

pub fn add(a: Vec2, b: Vec2) -> Vec2
  { x = a.x + b.x, y = a.y + b.y }
end

pub fn scale(v: Vec2, k: f32) -> Vec2
  { x = v.x * k, y = v.y * k }
end

pub fn overlaps(a: Rock, b: Rock) -> bool
  dx := a.pos.x - b.pos.x
  dy := a.pos.y - b.pos.y
  r  := a.radius + b.radius
  dx * dx + dy * dy < r * r          -- implicit tail return: an expression
end

pub fn advance(r: !Rock)
  r!.pos = r.pos.add(r.vel)          -- UFCS, and the mutation mark on the place
end

-- `match` is a statement, so it has no tail position: each arm returns.
-- This is §6.7's rule as a worked case, not an oversight.
pub fn extent(s: Shape) -> f32
  match s do
    point then
      return 0.0
    end
    circle(radius) then
      return radius
    end
    box(lo, hi) then
      return hi.x - lo.x
    end
  end
end

-- Absence is `?T`, and it is the only absence concept (ch2 §9.1). A generic
-- function, with its type parameter unconstrained (ch1 §10.2). `return x`
-- injects a present value; `none` is the prelude's nullary constructor
-- (ch2 §9.11, §9.2).
pub fn first[T](xs: []T) -> ?T
  for x in xs do
    return x
  end
  return none
end

-- `?T` is an ordinary sum type, so `match` handles it with the prelude
-- constructors and no wildcard arm (ch2 §9.2, §4.5).
pub fn radius_of(xs: []Rock) -> f32
  match first(xs) do
    none then
      return 0.0
    end
    some(r) then
      return r.radius
    end
  end
end

-- `?.` short-circuits and yields `?f32` for the chain; `or` unwraps it.
-- The two words are not interchangeable: `or` handles absence, `rescue`
-- handles failure (ch2 §10.13).
pub fn lead_radius(xs: []Rock) -> f32
  first(xs)?.radius or 0.0
end

-- A function value is a non-capturing `fn` pointer, and it is passed by name
-- because every function is top-level and named (ch2 §7.1, §7.3). UFCS never
-- applies to it: this body writes `keep(x)`, never `x.keep()` (ch2 §7.5).
pub fn is_big(r: Rock) -> bool
  r.radius > 8.0
end

pub fn count_where(xs: []Rock, keep: fn(Rock) -> bool) -> usize
  n: usize = 0
  for x in xs do
    n += 1 if keep(x)
  end
  n
end

-- An interface is a fifth type body and is declared by the one `type` shape
-- (ch2 §6.7.1). Members are `fn` headers with no body, and there is no receiver
-- and no `Self`: the interface names the type it constrains through its own
-- generic parameter, so `T` appears in the signature (ch2 §6.7.2).
pub type Ranked[T] = interface
  fn rank(v: T) -> f32
end

-- Satisfaction is declared explicitly, never structural (ch2 §6.2). The `impl`
-- carries no body and no `pub`, its generic argument is written out, and it
-- lives in `Rock`'s declaring module (ch2 §6.7.3, §6.7.3.1, §6.7.5, §6.7.6).
-- `rank` below is an ordinary module-level function; nothing about it is
-- marked, and it is what discharges the assertion.
impl Rock: Ranked[Rock]

pub fn rank(v: Rock) -> f32
  v.radius
end

-- The constraint is the interface, in the one position an interface may appear
-- (ch2 §6.4). Dispatch is static: this monomorphises per `T` and no boxed
-- existential exists (ch2 §6.3).
pub fn best[T: Ranked[T]](xs: []T) -> ?T
  top: ?T = none
  best_rank: f32 = 0.0
  for x in xs do
    r := rank(x)
    match top do
      none then
        top = x
        best_rank = r
      end
      some(_) then
        if r > best_rank then
          top = x
          best_rank = r
        end
      end
    end
  end
  return top
end

-- Failure is a value in the return type, and the set is elided to this file's
-- one declared error enum (ch2 §10.1, §10.6). A failure is returned by
-- returning a value of the error set, qualified (ch2 §10.6.1, §4.6.1).
pub fn checked_count(xs: []Rock) -> usize rescue
  return FieldError.empty if xs.len == 0
  return FieldError.too_many(xs.len) if xs.len > MAX_ROCKS
  xs.len
end

-- The three `rescue` tails, in order: a default, a bound handler, and a
-- diverging tail (ch2 §10.8).
pub fn report(xs: []Rock) -> usize
  lenient := checked_count(xs) rescue 0

  strict := checked_count(xs) rescue err then
    match err do
      empty then
        return 0
      end
      too_many(n) then
        return n
      end
    end
  end

  _ = lenient                        -- must-use is discharged by one token
  strict
end

pub fn total(xs: []Rock) -> usize rescue
  n := checked_count(xs) rescue return
  n
end

-- ---------------------------------------------------------------------------
-- Chapter 3 adds memory: layout, the two aggregates and their literal, views
-- and the rules that keep them from dangling, moves, and multiple returns.
-- ---------------------------------------------------------------------------

-- `#align(n)` is the one layout attribute, and it is type-level (ch3 §8.3).
-- Field order is guaranteed and padding is C-compatible, so this struct's bytes
-- are exactly what is written here, with no reordering (ch3 §8.2).
#align(16)
type Bounds = struct
  lo: Vec2
  hi: Vec2
end

-- The two core aggregates are `struct` and `[N]T`; everything else is a library
-- generic (ch3 §4.1). This is an SoA field by hand: two columns, one length.
type Field = struct
  pos:  [MAX_ROCKS]Vec2 = {}
  vel:  [MAX_ROCKS]Vec2 = {}
  live: usize = 0
end

-- `Handle[T]` is copyable plain data, so it lives in a struct field (ch3 §10.3),
-- and a handle to a released object reads as absence, never as a bug (ch3
-- §10.2). That is why the field is `?Handle[Rock]` and not a pointer.
type Tracker = struct
  quarry: ?Handle[Rock]
end

-- A `{...}` literal is a fixed-size value and allocates nothing, so this
-- function names no allocator (ch3 §5.4). The target type decides what the
-- literal means (ch3 §5.1), literals nest (ch3 §5.9), and struct literals are
-- named-field only (ch3 §5.6).
pub fn unit_bounds() -> Bounds
  { lo = { x = 0.0, y = 0.0 }, hi = { x = 1.0, y = 1.0 } }
end

-- `[]T` is the universal boundary: this one function accepts a `[N]Vec2`, a
-- `List[Vec2]` and an SoA pool's `pos` column alike, and mentions none of them
-- (ch3 §6.1). The writable view is marked at the parameter, and the mutation
-- mark rides the root binding at the use site (ch1 §7.10).
pub fn integrate(pos: ![]Vec2, vel: []Vec2, dt: f32)
  for i in 0..<pos.len do
    pos![i] = pos[i].add(vel[i].scale(dt))
  end
end

-- The columnar batch call, and the first line in this program to take a
-- **writable sub-view** rather than a whole place (#101). The mark sits after
-- the root binding and the slice suffix follows: `pos![0..<live]`, never
-- `pos[0..<live]!`, which parses and is an error (ch3 §6.12).
--
-- `pos` and `vel` are two views live at once, which is legal: there is no
-- exclusivity rule between views (ch3 §7.4).
pub fn integrate_live(pos: ![]Vec2, vel: []Vec2, live: usize, dt: f32)
  integrate(pos![0..<live], vel[0..<live], dt)
end

-- A function may return a view only where the view derives from its receiver
-- (ch3 §6.5) — here, the receiver's own array. A function with no receiver to
-- derive from could not write this signature at all.
pub fn positions(f: Field) -> []Vec2
  f.pos[0..<f.live]
end

-- Invalidation, written as the re-take the rule requires (ch3 §7.1). A view
-- dies when the place it derives from is next used with `!`, and the kill is
-- flow-insensitive, so it does not matter which branch the mark sits in.
--
--   v := positions(f)
--   f!.live += 1                    -- the mark kills v
--   $.print(v.len)                  -- error: v was invalidated by `f!` above
--
-- The fix needs no annotation: take the view again after the mutation.
pub fn spawn(f: !Field, at: Vec2) -> usize
  f!.pos[f.live] = at
  f!.vel[f.live] = { x = 0.0, y = 0.0 }
  f!.live += 1
  v := positions(f)
  v.len
end

-- Fixed-arity multiple returns, destructured at the call site. The returned
-- group has no type, cannot be stored or passed on, and destructuring must be
-- total (ch3 §14).
pub fn extremes(f: Field) -> Vec2, Vec2
  b := unit_bounds()
  return b.lo, b.hi if f.live == 0
  b.lo, b.hi
end

-- Top level runs once, in the entry file only (#26). This is that file.

$.print("reference program")

persist tick: u64 = 0

-- A `persist` declaration holds a plain value with no pointer in it, so it
-- survives a reload by the same rule a bare `[N]u8` does (ch3 §8.2, ADR-0042
-- §7). A view could not appear here: `persist` is one of the positions a view
-- is banned from (ch3 §6.3).
persist field: !Field = {}

-- A `persist` container is legal, and it is the one position where allocation
-- failure is a fault rather than a value (ch3 §11.10): there is no `return` to
-- `rescue` into, no signature to declare an error set on, and the fallback that
-- would compile -- an empty list -- starts the program against an empty world.
-- `heap` is legal here and nowhere else (ch3 §1.6, §9.12), and the `List`
-- implementation is runner-owned, which is what keeps this declaration clear of
-- #17 §3's function-pointer check (ch3 §11.12).
persist trail: !List[Vec2] = List.from(heap, { { x = 0.0, y = 0.0 } })

frame(screen: !Target, scratch: !Scratch)
  tick! += 1

  -- The batch op runs every frame, over exactly the live prefix.
  integrate_live(field!.pos, field.vel, field.live, 1.0 / 60.0)

  return unless tick % 60 == 0       -- statement modifier over a bool condition

  n := spawn(field!, { x = 8.0, y = 8.0 })

  -- `reserve` is additional and idempotent -- room for 2 *beyond* `len` -- and
  -- exists for timing, not failure: a program that must not allocate mid-frame
  -- pre-sizes (ch3 §11.7). It allocates, so it is fallible like every other
  -- allocating call (ch3 §11.6). There is no `capacity()` to interrogate
  -- afterwards; having reserved is the answer (ch3 §11.8).
  trail!.reserve(2) rescue return

  -- `push` is argument-free because the `List` captured its allocator, and
  -- fallible because it may grow. The `rescue` is the ceremony ch3 §11.1 names,
  -- and it declares nothing on `frame`: propagation is local (ch3 §11.11).
  lo, hi := extremes(field)          -- total destructuring of a multi-return
  trail!.push(lo) rescue return
  trail!.push(hi) rescue return

  -- `string` is the type of a literal and of nothing else; it widens one way
  -- to `[]u8` at parameter position (ch2 §17.1, §17.2).
  label: string = "elapsed"

  -- `chars()` decodes UTF-8 and yields `char`; `bytes()` does not exist
  -- (ch2 §17.7, §2.6).
  glyphs: usize = 0
  for c in label.chars() do
    _ = c
    glyphs += 1
  end

  -- A cast is the only numeric conversion (ch2 §2.8). What this one yields for
  -- a lossy or out-of-range value is undecided — spec ch2 §20, issue #98.
  secs := (tick / 60) as f32

  -- `format` writes into a buffer the caller owns and returns a view of what it
  -- wrote; the format string is a literal the compiler checks (ch2 §17.5).
  buf: [32]u8 = {}
  line := format(buf!, "{}: {} ({} chars, {} live)", label, secs, glyphs, n)
  $.print(line)

  -- The two reference forms, one line apart. `vec_utils` is the name the
  -- library claims for itself -- this file cannot rename or alias it (ch4
  -- §2.3, §2.4) -- and `hud` is this file's own module, bound from the stem of
  -- the path that named it (ch4 §3.4).
  --
  -- `vec_utils.EPSILON` is a library constant, and reaching it runs nothing:
  -- an imported module's top level is declarations only (ch4 §13.1, §13.3).
  --
  -- What this file may *not* write is `scale.halve(...)`. `vec_utils` reaches
  -- its own second file by path; that does not make the name visible here, and
  -- there is no `use` that would help -- non-transitivity is not a resolution
  -- question (ch4 §4.2, §4.3).
  reach := hud.squared(lo.x, lo.y) + vec_utils.EPSILON
  edge: [32]u8 = {}
  $.print(format(edge!, "reach {} banner {}", reach, hud.banner_radius(reach)))
end
